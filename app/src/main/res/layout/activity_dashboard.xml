<?xml version="1.0" encoding="utf-8"?>
<!-- Home/Dashboard: ConstraintLayout (header + scroll area) with the modules in a GridLayout -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDate"
                style="@style/TextAppearance.CampusMate.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/TextAppearance.CampusMate.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                style="@style/TextAppearance.CampusMate.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/primary"
            android:clickable="true"
            android:contentDescription="@string/cd_open_profile"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@color/on_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Semester banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_banner_title"
                            android:textColor="@color/on_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.85"
                            android:text="@string/dashboard_banner_body"
                            android:textColor="@color/on_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_school"
                        app:tint="@color/on_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.CampusMate.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/dashboard_modules" />

            <!-- GridLayout: 2 columns in portrait, 3 in landscape (values-land/integers.xml) -->
            <GridLayout
                android:id="@+id/gridModules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/grid_columns"
                android:useDefaultMargins="false">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCourses"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_blue_bg"
                            android:src="@drawable/ic_courses"
                            app:tint="@color/mod_blue" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_courses" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_courses_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTimetable"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_green_bg"
                            android:src="@drawable/ic_timetable"
                            app:tint="@color/mod_green" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_timetable" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_timetable_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAttendance"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_teal_bg"
                            android:src="@drawable/ic_attendance"
                            app:tint="@color/mod_teal" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_attendance" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_attendance_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResults"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_purple_bg"
                            android:src="@drawable/ic_results"
                            app:tint="@color/mod_purple" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_results" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_results_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNotices"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_orange_bg"
                            android:src="@drawable/ic_notices"
                            app:tint="@color/mod_orange" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_notices" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_notices_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfile"
                    style="@style/Widget.CampusMate.ModuleCard">

                    <LinearLayout style="@style/Widget.CampusMate.ModuleCardContent">

                        <ImageView
                            style="@style/Widget.CampusMate.ModuleIcon"
                            android:backgroundTint="@color/mod_red_bg"
                            android:src="@drawable/ic_person"
                            app:tint="@color/mod_red" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardTitle"
                            android:text="@string/module_profile" />

                        <TextView
                            style="@style/TextAppearance.CampusMate.CardSubtitle"
                            android:text="@string/module_profile_desc" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
