<?xml version="1.0" encoding="utf-8"?>
<!-- Profile: ConstraintLayout for the page, LinearLayouts for the info rows -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <include
            android:id="@+id/btnBack"
            layout="@layout/view_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTopTitle"
            style="@style/TextAppearance.CampusMate.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/profile_title"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/primary"
            android:gravity="center"
            android:textColor="@color/on_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvName"
            style="@style/TextAppearance.CampusMate.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAvatar" />

        <TextView
            android:id="@+id/tvEmail"
            style="@style/TextAppearance.CampusMate.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvName" />

        <TextView
            android:id="@+id/tvInfoHeading"
            style="@style/TextAppearance.CampusMate.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/profile_account_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvEmail" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInfoHeading"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout style="@style/Widget.CampusMate.InfoRow">
                    <TextView
                        style="@style/TextAppearance.CampusMate.InfoLabel"
                        android:text="@string/profile_label_name" />
                    <TextView
                        android:id="@+id/tvInfoName"
                        style="@style/TextAppearance.CampusMate.InfoValue" />
                </LinearLayout>

                <View style="@style/Widget.CampusMate.Divider" />

                <LinearLayout style="@style/Widget.CampusMate.InfoRow">
                    <TextView
                        style="@style/TextAppearance.CampusMate.InfoLabel"
                        android:text="@string/profile_label_username" />
                    <TextView
                        android:id="@+id/tvInfoUsername"
                        style="@style/TextAppearance.CampusMate.InfoValue" />
                </LinearLayout>

                <View style="@style/Widget.CampusMate.Divider" />

                <LinearLayout style="@style/Widget.CampusMate.InfoRow">
                    <TextView
                        style="@style/TextAppearance.CampusMate.InfoLabel"
                        android:text="@string/profile_label_email" />
                    <TextView
                        android:id="@+id/tvInfoEmail"
                        style="@style/TextAppearance.CampusMate.InfoValue" />
                </LinearLayout>

                <View style="@style/Widget.CampusMate.Divider" />

                <LinearLayout style="@style/Widget.CampusMate.InfoRow">
                    <TextView
                        style="@style/TextAppearance.CampusMate.InfoLabel"
                        android:text="@string/profile_label_type" />
                    <TextView
                        android:id="@+id/tvInfoType"
                        style="@style/TextAppearance.CampusMate.InfoValue" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPrefsHeading"
            style="@style/TextAppearance.CampusMate.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/profile_preferences"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardInfo" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrefs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPrefsHeading"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDarkTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/profile_dark_theme"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.CampusMate.Button.Logout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/action_logout"
            app:icon="@drawable/ic_logout"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPrefs"
            app:layout_constraintVertical_bias="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
